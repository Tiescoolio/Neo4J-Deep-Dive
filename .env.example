# Kopieer naar .env; vul uitsluitend lokale demoverbindingen in.
# PostgreSQL moet de afzonderlijke database film_demo zijn.
PG_DSN=postgresql://film_demo_owner:VUL_IN@localhost:5433/film_demo
# Neo4j moet de afzonderlijke database film-demo zijn.
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_DATABASE=film-demo
NEO4J_USERNAME=VUL_SCHRIJFACCOUNT_IN
NEO4J_PASSWORD=VUL_IN
# Apart leesaccount voor alle retrieval, inclusief gegenereerde Cypher.
NEO4J_READER_USERNAME=film_demo_reader
NEO4J_READER_PASSWORD=VUL_IN
OLLAMA_HOST=http://127.0.0.1:11434
EMBEDDING_MODEL=embeddinggemma:latest
LLM_MODEL=gemma4:26b
